# Copy to .env and fill in. .env is gitignored -- never commit real keys.
#   cp .env.example .env
#
# The container-side block is loaded into the cluster as a Secret:
#   kubectl create secret generic sft-env --from-env-file=.env
# and pulled in by k8s/pytorchjob.yaml via envFrom. Re-create the secret after
# every edit:
#   kubectl delete secret sft-env --ignore-not-found && \
#     kubectl create secret generic sft-env --from-env-file=.env
#
# Locally, src/entrypoint.sh sources .env if it sits next to the repo root.

# ---------------------------------------------------------------------------
# LLM entry point
# ---------------------------------------------------------------------------
# HF repo id of the model to fine-tune. Verify it exists:
#   curl -s -o /dev/null -w '%{http_code}\n' https://huggingface.co/api/models/<repo-id>
MODEL_NAME=Qwen/Qwen3-1.7B
# Token for private / gated repos, and for higher download rate limits.
HF_TOKEN=
# Mirror endpoint, e.g. https://hf-mirror.com. Leave empty for the default hub.
HF_ENDPOINT=
# Model cache. Keep it on the PVC so pod restarts do not re-download.
HF_HOME=/data/hf

# ---------------------------------------------------------------------------
# Training
# ---------------------------------------------------------------------------
OUTPUT_DIR=/data/runs/qwen-sft
TRAIN_FILE=/workspace/data/train.jsonl
EVAL_FILE=/workspace/data/val.jsonl
DEEPSPEED_CONFIG=/workspace/configs/ds.json
MAX_SEQ_LEN=4096
EPOCHS=2
LEARNING_RATE=1e-5
MICRO_BATCH_SIZE=1
GRAD_ACCUM=16
WARMUP_RATIO=0.03
LOGGING_STEPS=10
SAVE_STEPS=500
SAVE_TOTAL_LIMIT=2
NUM_WORKERS=4
SEED=42

# ---------------------------------------------------------------------------
# Runtime tuning
# ---------------------------------------------------------------------------
NCCL_DEBUG=WARN
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
TOKENIZERS_PARALLELISM=false

# ---------------------------------------------------------------------------
# Experiment tracking (optional). REPORT_TO="" disables it.
# ---------------------------------------------------------------------------
REPORT_TO=
WANDB_API_KEY=
WANDB_PROJECT=context-comp-sft

# ---------------------------------------------------------------------------
# Optional: OpenAI-compatible endpoint, for scripts that call an LLM for
# evaluation or data generation. Unused by train_sft.py.
# ---------------------------------------------------------------------------
OPENAI_BASE_URL=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Local shell only -- used by docker build / kubectl, not by the container.
# ---------------------------------------------------------------------------
IMAGE=gitlab-registry.nrp-nautilus.io/YOUR_USER/context-comp-sft:latest
K8S_NAMESPACE=YOUR_NAMESPACE
PVC_NAME=qwen-sft-data
