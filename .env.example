# Copy to .env and fill in, then run ./run.sh
#   cp .env.example .env
#
# Values here mirror the configuration that produced qwen3-8b-sft-v3: full-parameter
# SFT of Qwen3-8B on labelled chain-of-thought, one epoch, on a single 80GB A100.
# Four things must be filled in by hand: K8S_NAMESPACE, IMAGE, NRP_REGISTRY_TOKEN,
# and HF_TOKEN. Everything else runs as-is.
#
# NOTE: run.sh uploads this whole file into the namespace as the sft-env Secret, and
# a k8s Secret is only base64-encoded -- anyone with namespace access can read it.
# Keep unrelated credentials (Claude Code, Codex, personal CLI tokens) in your shell
# profile, not here.

# ---------------------------------------------------------------------------
# NRP cluster access (used by ./run.sh)
# ---------------------------------------------------------------------------
K8S_NAMESPACE=YOUR_NAMESPACE

# Registry path of the GitLab project the token belongs to, lowercased, plus a
# sub-repository name for this image. Find the exact prefix on the project's
# Deploy > Container Registry page, or via the API:
#   curl -s -H "PRIVATE-TOKEN: $NRP_REGISTRY_TOKEN" \
#     https://gitlab.nrp-nautilus.io/api/v4/projects/<id> | grep container_registry_image_prefix
IMAGE=gitlab-registry.nrp-nautilus.io/your-group/your-project/context-comp-sft:latest

# GitLab token with read_registry + write_registry, used for `docker login` and for
# the image-pull Secret. Paste the token value only (starts with glpat-), not its name.
NRP_REGISTRY_TOKEN=
# Empty: run.sh derives it from IMAGE. Set it explicitly only for a deploy token,
# whose user is the token name rather than a GitLab username.
NRP_REGISTRY_USER=

# ---------------------------------------------------------------------------
# Model and caches
# ---------------------------------------------------------------------------
MODEL_NAME=Qwen/Qwen3-8B
# For private / gated repos and for higher download rate limits.
HF_TOKEN=
# Mirror endpoint, e.g. https://hf-mirror.com. Empty means the default hub.
HF_ENDPOINT=
# Model cache on the PVC, so pod restarts do not re-download 16GB.
HF_HOME=/data/hf
# Keep the tokenized arrow cache on container-local disk. It is memory-mapped and
# read at random every step; on the PVC, which may be mounted from another region,
# that crawls at ~175KB/s. Model weights stay on the PVC (read once, sequentially).
HF_DATASETS_CACHE=/workspace/.cache/datasets

# ---------------------------------------------------------------------------
# Training
# ---------------------------------------------------------------------------
# Point this at a new directory per run. Reusing one whose run already finished
# makes training a no-op, and an 8B run would overwrite whatever is there.
OUTPUT_DIR=/data/runs/qwen3-8b-sft-v3
TRAIN_FILE=/workspace/data_labeled_2/train.jsonl
EVAL_FILE=/workspace/data_labeled_2/validation.jsonl
# ZeRO-2 + CPU optimizer offload -- required for 8B on one GPU. The optimizer state
# alone is ~98G, which no single card holds alongside weights and gradients.
# configs/ds_stage0.json is plain data parallel, for models up to ~2.5B.
DEEPSPEED_CONFIG=/workspace/configs/ds.json

MAX_SEQ_LEN=12288
EPOCHS=1
LEARNING_RATE=1e-5
WARMUP_RATIO=0.03
WEIGHT_DECAY=0.0
MICRO_BATCH_SIZE=1
# Global batch 64. Each optimizer step runs Adam over 8B parameters on the CPU and
# costs tens of seconds, so accumulating more and stepping less is a real speedup.
GRAD_ACCUM=64

# 5042 samples at global batch 64 is 79 steps per epoch, so this saves once mid-run.
SAVE_STEPS=40
SAVE_TOTAL_LIMIT=1
# Weights only (~16G) instead of weights + optimizer state (~115G). The latter is
# what OOMKilled this job three times: writing 115G fills the container's page cache,
# which counts against the memory cgroup. Resume then restarts the optimizer rather
# than restoring it -- an acceptable trade for a run that otherwise cannot finish.
SAVE_ONLY_MODEL=true
# auto: pick up a completed checkpoint left in OUTPUT_DIR, which matters on NRP where
# pods get evicted. no: ignore any checkpoint and train from scratch.
RESUME=auto
# auto detects from the data whether targets open their own <think> block. Set true
# or false only to override that; getting it wrong silently corrupts the sequence.
ENABLE_THINKING=auto

# Match the pod's cpu request minus the cores DeepSpeedCPUAdam wants.
NUM_WORKERS=2
LOGGING_STEPS=10
SEED=42

# ---------------------------------------------------------------------------
# Monitoring
# ---------------------------------------------------------------------------
# Empty disables it. "wandb" streams loss/lr/grad_norm plus GPU metrics to wandb.ai,
# which survives a dropped kubectl connection or an evicted pod -- worth having on a
# run that takes hours.
REPORT_TO=wandb
# From https://wandb.ai/authorize. Required unless WANDB_MODE=offline.
WANDB_API_KEY=
WANDB_PROJECT=context-comp-sft
# WANDB_MODE=offline

# ---------------------------------------------------------------------------
# Evaluation (evaluate/) -- OpenAI-compatible endpoint for the LLM judge.
# On NRP this is the managed LLM gateway; the key comes from nrp.ai under AI/LLMs.
# Model ids are whatever the gateway exposes, not upstream names:
#   curl -s -H "Authorization: Bearer $OPENAI_API_KEY" $OPENAI_BASE_URL/models
# ---------------------------------------------------------------------------
OPENAI_BASE_URL=https://ellm.nrp-nautilus.io/v1
OPENAI_API_KEY=
EVAL_JUDGE_MODEL=qwen3-small

# ---------------------------------------------------------------------------
# Runtime tuning
# ---------------------------------------------------------------------------
NCCL_DEBUG=WARN
# torch renamed this from PYTORCH_CUDA_ALLOC_CONF; an OOM message may still cite the
# old name, in which case set both.
PYTORCH_ALLOC_CONF=expandable_segments:True
TOKENIZERS_PARALLELISM=false

# ---------------------------------------------------------------------------
# Local only -- used by run.sh on your machine, ignored inside the container.
# ---------------------------------------------------------------------------
PVC_NAME=qwen-sft-data
JOB_NAME=qwen-sft
# Interpreter for the local data-prep step.
PYTHON_BIN=python3
