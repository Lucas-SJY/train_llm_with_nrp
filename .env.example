# Copy to .env and fill in, then run ./run.sh
#   cp .env.example .env
#
# .env is gitignored. Only three things must be filled in by hand:
#   IMAGE, NRP_REGISTRY_TOKEN, K8S_NAMESPACE
#
# NOTE: run.sh uploads this file into the namespace as the sft-env Secret, and a
# k8s Secret is only base64-encoded -- anyone with namespace access can read it.
# Keep unrelated credentials (Claude Code / Codex / personal CLI tokens) in your
# shell profile, not here.

# ---------------------------------------------------------------------------
# NRP cluster access
# ---------------------------------------------------------------------------
K8S_NAMESPACE=YOUR_NAMESPACE

# Image to build and run. The GitLab container registry is per project, so the path
# is <project-path-lowercased>/<image-name>:<tag>. Find the exact prefix on the
# project's Deploy > Container Registry page, or via the API:
#   curl -s -H "PRIVATE-TOKEN: $NRP_REGISTRY_TOKEN" \
#     https://gitlab.nrp-nautilus.io/api/v4/projects/<id> | grep container_registry_image_prefix
IMAGE=gitlab-registry.nrp-nautilus.io/your-group/your-project/context-comp-sft:latest

# GitLab token used for `docker login` and for the image-pull Secret.
# Create one with read_registry + write_registry scope at
#   https://gitlab.nrp-nautilus.io/-/user_settings/personal_access_tokens
# Paste the token value only (starts with glpat-), not the token name.
NRP_REGISTRY_TOKEN=

# Login user. Leave empty and run.sh derives it from IMAGE (the path segment
# after the host). Set it explicitly only if your GitLab username differs, or
# if you are using a deploy token, whose user is the token name.
NRP_REGISTRY_USER=

# ---------------------------------------------------------------------------
# Training model entry point (HuggingFace)
# ---------------------------------------------------------------------------
# Verify a repo id exists:
#   curl -s -o /dev/null -w '%{http_code}\n' https://huggingface.co/api/models/<repo-id>
MODEL_NAME=Qwen/Qwen3-1.7B
# Token for private / gated repos, and for higher download rate limits.
HF_TOKEN=
# Mirror endpoint, e.g. https://hf-mirror.com. Empty means the default hub.
HF_ENDPOINT=
# Model cache. On the PVC so pod restarts do not re-download.
HF_HOME=/data/hf

# ---------------------------------------------------------------------------
# NRP managed LLM (OpenAI-compatible). For eval / data-generation scripts,
# not used by train_sft.py. Key from https://nrp.ai -> AI/LLMs -> API access.
# ---------------------------------------------------------------------------
OPENAI_BASE_URL=https://ellm.nrp-nautilus.io/v1
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Training
# ---------------------------------------------------------------------------
OUTPUT_DIR=/data/runs/qwen-sft
TRAIN_FILE=/workspace/data/train.jsonl
EVAL_FILE=/workspace/data/val.jsonl
DEEPSPEED_CONFIG=/workspace/configs/ds.json
MAX_SEQ_LEN=4096
EPOCHS=2
LEARNING_RATE=1e-5
MICRO_BATCH_SIZE=1
GRAD_ACCUM=32
WARMUP_RATIO=0.03
LOGGING_STEPS=10
SAVE_STEPS=500
SAVE_TOTAL_LIMIT=2
NUM_WORKERS=4
SEED=42

# ---------------------------------------------------------------------------
# Runtime tuning
# ---------------------------------------------------------------------------
NCCL_DEBUG=WARN
# torch >=2.13 renamed this from PYTORCH_CUDA_ALLOC_CONF.
PYTORCH_ALLOC_CONF=expandable_segments:True
TOKENIZERS_PARALLELISM=false

# ---------------------------------------------------------------------------
# Experiment tracking (optional). REPORT_TO="" disables it.
# ---------------------------------------------------------------------------
REPORT_TO=
WANDB_API_KEY=
WANDB_PROJECT=context-comp-sft

# ---------------------------------------------------------------------------
# Local only -- used by run.sh on your laptop, ignored inside the container.
# ---------------------------------------------------------------------------
PVC_NAME=qwen-sft-data
JOB_NAME=qwen-sft
# Interpreter used for the local data-prep step.
PYTHON_BIN=python3
